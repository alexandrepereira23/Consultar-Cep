# Backend - Spring Boot
SPRING_PROFILES_ACTIVE=prod
PORT=8080

API_KEY_VALOR=troque-por-uma-chave-forte
RATE_LIMIT_REQUISICOES=60
RATE_LIMIT_JANELA=1m
CORS_ORIGENS_PERMITIDAS=https://seu-frontend.vercel.app

VIACEP_URL_BASE=https://viacep.com.br/ws
BRASILAPI_URL_BASE=https://brasilapi.com.br/api/cep/v2

# Frontend - Angular/Vercel
# O frontend usa environment.prod.ts no build de produção via fileReplacements do Angular.
# Ajuste apiBaseUrl em frontend/src/environments/environment.prod.ts para https://api-cep.usenexora.online/api/v1.
# API_BASE_URL não é lida automaticamente pelo frontend.
# NUNCA configure API_KEY_VALOR no frontend ou nas variáveis da Vercel (API_KEY_VALOR é segredo exclusivo do backend).
